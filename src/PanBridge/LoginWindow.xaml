<Window x:Class="PanBridge.LoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" Title="登录交大云盘" Icon="Assets/PanBridge.ico" Width="1050" Height="790" MinWidth="800" MinHeight="620" WindowStartupLocation="CenterOwner" Background="#FAFBFE" FontFamily="Microsoft YaHei UI">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="20,12" Background="#EDF3FF">
      <StackPanel>
        <TextBlock Text="交大账号登录" FontSize="17" FontWeight="SemiBold" Foreground="#1D293D" />
        <TextBlock x:Name="LoginStatus" Text="正在打开交大官方登录页面…" Margin="0,5,0,0" Foreground="#5D718F" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Padding="20,10">
      <TextBlock Text="请在官方页面完成登录和验证码。客户端自动保存加密 Cookie，无需复制令牌。" Foreground="#6B778B" FontSize="12" />
    </Border>
    <wv:WebView2 x:Name="Browser" />
  </DockPanel>
</Window>