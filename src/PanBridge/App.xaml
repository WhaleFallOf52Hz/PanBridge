<Application x:Class="PanBridge.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Ink" Color="#17272B" />
    <SolidColorBrush x:Key="Muted" Color="#62757A" />
    <Style TargetType="Button">
      <Setter Property="Padding" Value="18,10" /><Setter Property="Margin" Value="0,0,10,0" />
      <Setter Property="FontSize" Value="14" /><Setter Property="Cursor" Value="Hand" />
      <Setter Property="Background" Value="#E8EEEF" /><Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.85" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4" /></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Application.Resources>
</Application>
