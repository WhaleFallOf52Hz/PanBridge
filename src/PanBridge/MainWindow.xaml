<Window x:Class="PanBridge.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="交云桥 · PanBridge" Icon="Assets/PanBridge.ico" Width="1020" Height="740" MinWidth="920" MinHeight="660" WindowStartupLocation="CenterScreen" Background="#FAFBFE" FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="{StaticResource Ink}" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <Style TargetType="TabItem">
      <Setter Property="Margin" Value="0,3" />
      <Setter Property="Padding" Value="15,13" />
      <Setter Property="Foreground" Value="#647187" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="Nav" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Nav" Property="Background" Value="#EBEFF7" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Nav" Property="Background" Value="#E5EDFC" />
                <Setter Property="Foreground" Value="#225DC8" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="NavIcon" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Width" Value="29" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="PageScroll" TargetType="ScrollViewer">
      <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="Padding" Value="32,29,32,20" />
      <Setter Property="Focusable" Value="False" />
    </Style>
    <Style x:Key="Rule" TargetType="Border">
      <Setter Property="Height" Value="1" />
      <Setter Property="Background" Value="{StaticResource Line}" />
      <Setter Property="Margin" Value="0,18" />
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TabControl x:Name="Navigation" TabStripPlacement="Left" Background="Transparent" BorderThickness="0" SelectedIndex="0" KeyboardNavigation.TabNavigation="Continue">
      <TabControl.Template>
        <ControlTemplate TargetType="TabControl">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="194" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="#F3F6FB" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
              <Grid Margin="14,0">
                <Grid.RowDefinitions>
                  <RowDefinition Height="105" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="75" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                  <Image Source="Assets/PanBridge.png" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality" />
                  <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="交云桥" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="PanBridge" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,2,0,0" />
                  </StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="1" IsItemsHost="True" KeyboardNavigation.TabIndex="0" />
                <StackPanel Grid.Row="2" Margin="16,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="为交大云盘搭一座桥" FontSize="11" Foreground="{StaticResource Muted}" />
                  <TextBlock Text="本地挂载 · 托盘常驻" FontSize="11" Foreground="#8A96A8" Margin="0,6,0,0" />
                </StackPanel>
              </Grid>
            </Border>
            <ContentPresenter Grid.Column="1" x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" KeyboardNavigation.TabIndex="1" />
          </Grid>
        </ControlTemplate>
      </TabControl.Template>
      <TabItem x:Name="OverviewTab" AutomationProperties.Name="概览">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource NavIcon}" Text="" />
            <TextBlock Text="概览" />
          </StackPanel>
        </TabItem.Header>
        <ScrollViewer Style="{StaticResource PageScroll}">
          <StackPanel MaxWidth="900">
            <TextBlock Text="概览" Style="{StaticResource Title}" />
            <TextBlock Text="交大云盘与本机的连接，一目了然。" Style="{StaticResource Subtitle}" />
            <Border Style="{StaticResource Card}" Padding="24">
              <StackPanel>
                <DockPanel LastChildFill="False">
                  <StackPanel Orientation="Horizontal">
                    <Border Background="#EDF3FF" CornerRadius="10" Width="46" Height="46">
                      <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Accent}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="13,2,0,0">
                      <TextBlock Text="上海交通大学云盘" FontWeight="SemiBold" FontSize="14" />
                      <TextBlock Text="pan.sjtu.edu.cn" Style="{StaticResource Caption}" FontFamily="Segoe UI" Margin="0,3,0,0" />
                    </StackPanel>
                  </StackPanel>
                  <Border DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#F0F6F4" CornerRadius="4" Padding="10,5">
                    <TextBlock Text="{Binding Badge}" Foreground="{Binding BadgeColor}" FontSize="11" />
                  </Border>
                </DockPanel>
                <TextBlock x:Name="StateText" Text="{Binding StatusTitle}" FontSize="25" FontWeight="SemiBold" Margin="0,18,0,8" />
                <TextBlock Text="{Binding StatusDescription}" Foreground="{StaticResource Muted}" LineHeight="23" MaxWidth="590" HorizontalAlignment="Left" />
                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                  <Button x:Name="PrimaryButton" Content="{Binding PrimaryLabel}" Command="{Binding PrimaryCommand}" Style="{StaticResource PrimaryButton}" Padding="24,11" />
                  <Button Content="断开连接" Command="{Binding DisconnectCommand}" Style="{StaticResource TextButton}" Margin="10,0,0,0" Visibility="{Binding IsMounted, Converter={StaticResource VisibleIf}}" />
                </StackPanel>
                <Border Style="{StaticResource Rule}" Margin="0,18,0,16" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="本地盘符" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding DriveLabel}" FontWeight="SemiBold" FontSize="18" Margin="0,5,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="访问权限" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding AccessLabel}" FontWeight="Medium" FontSize="14" Margin="0,7,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="云盘根目录" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding EntryLabel}" FontWeight="Medium" FontSize="14" Margin="0,7,0,0" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
            <TextBlock Text="连接概况" Style="{StaticResource SectionTitle}" Margin="0,2,0,12" />
            <Border Style="{StaticResource Card}" Padding="22,17">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{Binding CloudLabel}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CloudDescription}" Style="{StaticResource Caption}" Margin="0,5,0,0" />
                  </StackPanel>
                  <Button Content="检测连接" Command="{Binding TestCommand}" Style="{StaticResource TextButton}" Grid.Column="1" VerticalAlignment="Center" />
                </Grid>
                <Border Style="{StaticResource Rule}" Margin="0,14" />
                <TextBlock Text="{Binding ServiceLabel}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding ServiceDescription}" Style="{StaticResource Caption}" Margin="0,5,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem x:Name="ConnectionTab" AutomationProperties.Name="连接与挂载">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource NavIcon}" Text="" />
            <TextBlock Text="连接与挂载" />
          </StackPanel>
        </TabItem.Header>
        <ScrollViewer Style="{StaticResource PageScroll}">
          <StackPanel MaxWidth="900">
            <TextBlock Text="连接与挂载" Style="{StaticResource Title}" />
            <TextBlock Text="管理官方登录、盘符和云盘访问权限。" Style="{StaticResource Subtitle}" />
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="云盘登录" Style="{StaticResource SectionTitle}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="{Binding AuthLabel}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding AuthDescription}" Style="{StaticResource Caption}" Margin="0,5,0,0" />
                    <TextBlock Text="{Binding ExpiryLabel}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                  </StackPanel>
                  <Button x:Name="LoginButton" Grid.Column="1" Content="{Binding LoginLabel}" Command="{Binding LoginCommand}" VerticalAlignment="Top" />
                </Grid>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="盘符与权限" Style="{StaticResource SectionTitle}" />
                <Grid IsEnabled="{Binding IsIdle}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,18,0">
                    <TextBlock Text="本地盘符" Style="{StaticResource Caption}" Margin="0,0,0,7" />
                    <ComboBox x:Name="DrivePicker" ItemsSource="{Binding AvailableDrives}" SelectedItem="{Binding SelectedDrive, Mode=TwoWay}" AutomationProperties.Name="本地盘符" />
                    <Button Content="刷新盘符" Command="{Binding RefreshDrivesCommand}" Style="{StaticResource TextButton}" Padding="0,8" HorizontalAlignment="Left" />
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="访问权限" Style="{StaticResource Caption}" Margin="0,0,0,7" />
                    <ComboBox x:Name="AccessPicker" ItemsSource="{Binding AccessModes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SelectedAccess, Mode=TwoWay}" AutomationProperties.Name="云盘访问权限" />
                    <TextBlock Text="{Binding DraftAccessDescription}" Style="{StaticResource Caption}" Margin="0,7,0,0" />
                  </StackPanel>
                </Grid>
                <Border Style="{StaticResource Rule}" Margin="0,14,0,18" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding ApplyHint}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,20,0" />
                  <Button x:Name="ApplyButton" Grid.Column="1" Content="保存并应用" Command="{Binding ApplyCommand}" />
                </Grid>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{Binding StatusTitle}" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding TransferLabel}" Style="{StaticResource Caption}" Margin="0,7,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="MountButton" Content="连接盘符" Command="{Binding MountCommand}" Style="{StaticResource PrimaryButton}" />
                    <Button x:Name="DisconnectButton" Content="断开" Command="{Binding DisconnectCommand}" Margin="8,0,0,0" />
                  </StackPanel>
                </Grid>
                <Border Style="{StaticResource Rule}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="连接检测会验证凭证并读取根目录。&#xA;已挂盘时，同时检查上传队列。" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                  <Button x:Name="TestButton" Grid.Column="1" Content="检测连接" Command="{Binding TestCommand}" VerticalAlignment="Center" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem x:Name="DiagnosticsTab" AutomationProperties.Name="故障诊断">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource NavIcon}" Text="" />
            <TextBlock Text="故障诊断" />
          </StackPanel>
        </TabItem.Header>
        <ScrollViewer Style="{StaticResource PageScroll}">
          <StackPanel MaxWidth="900">
            <TextBlock Text="故障诊断" Style="{StaticResource Title}" />
            <TextBlock Text="从云盘到本机，逐项检查连接链路。" Style="{StaticResource Subtitle}" />
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="{Binding DiagnosticSummary}" FontSize="19" FontWeight="SemiBold" />
                <TextBlock Text="{Binding DiagnosticTime}" Style="{StaticResource Caption}" Margin="0,8,0,18" />
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="DiagnoseButton" Content="运行诊断" Command="{Binding DiagnoseCommand}" Style="{StaticResource PrimaryButton}" />
                  <Button x:Name="ExportButton" Content="导出报告…" Command="{Binding ExportCommand}" Margin="10,0,0,0" />
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Background="#F1F5FC" CornerRadius="8" Padding="20,16" Margin="0,0,0,20">
              <StackPanel>
                <TextBlock Text="检查范围" FontWeight="SemiBold" Margin="0,0,0,7" />
                <TextBlock Text="挂载组件、程序文件、登录运行时、本地存储、云盘网络、登录凭证、本地服务、盘符与上传队列。报告不包含 Cookie、令牌、账号或文件名。" Style="{StaticResource Caption}" />
              </StackPanel>
            </Border>
            <ItemsControl x:Name="DiagnosticResults" ItemsSource="{Binding Checks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="20,17" Margin="0,0,0,10">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Label}" Foreground="{Binding Color}" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0" />
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,5,0,0" />
                        <TextBlock Text="{Binding AdviceText}" FontSize="12" Foreground="#966018" Margin="0,4,0,0">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding AdviceText}" Value="">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem x:Name="SettingsTab" AutomationProperties.Name="偏好设置">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource NavIcon}" Text="" />
            <TextBlock Text="偏好设置" />
          </StackPanel>
        </TabItem.Header>
        <ScrollViewer Style="{StaticResource PageScroll}">
          <StackPanel MaxWidth="900">
            <TextBlock Text="偏好设置" Style="{StaticResource Title}" />
            <TextBlock Text="常规偏好自动保存；修改缓存目录或空间上限后，请点击应用。" Style="{StaticResource Subtitle}" />
            <Border Style="{StaticResource Card}">
              <StackPanel IsEnabled="{Binding IsIdle}">
                <TextBlock Text="启动与窗口" Style="{StaticResource SectionTitle}" />
                <CheckBox x:Name="WindowsStartupCheck" Content="随 Windows 登录启动，在托盘运行" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
                <TextBlock Text="{Binding WindowsStartupStatus}" Style="{StaticResource Caption}" Margin="29,6,0,0" />
                <Button x:Name="WindowsStartupButton" Content="打开 Windows 启动应用设置" Command="{Binding WindowsStartupCommand}" Style="{StaticResource TextButton}" HorizontalAlignment="Left" Margin="22,4,0,0" />
                <Border Style="{StaticResource Rule}" />
                <CheckBox x:Name="AutoMountCheck" Content="启动客户端后自动连接云盘" IsChecked="{Binding AutoMount, Mode=TwoWay}" />
                <TextBlock Text="使用已保存的登录和盘符。与上方的 Windows 自启动选项配合，可在登录后自动连接云盘。" Style="{StaticResource Caption}" Margin="29,6,0,0" />
                <Border Style="{StaticResource Rule}" />
                <CheckBox x:Name="OpenAfterMountCheck" Content="连接成功后打开资源管理器" IsChecked="{Binding OpenAfterMount, Mode=TwoWay}" />
                <Border Style="{StaticResource Rule}" />
                <CheckBox x:Name="TrayHintCheck" Content="收起到托盘时显示提示" IsChecked="{Binding ShowTrayHint, Mode=TwoWay}" />
                <TextBlock Text="关闭或最小化窗口会继续在后台运行。需要退出时，请使用托盘菜单或下方的“退出程序”。" Style="{StaticResource Caption}" Margin="29,6,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="本地存储与隐私" Style="{StaticResource SectionTitle}" />
                <StackPanel IsEnabled="{Binding IsIdle}">
                  <TextBlock Text="缓存目录" Style="{StaticResource Caption}" Margin="0,0,0,7" />
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="CacheDirectoryBox" Text="{Binding CacheDirectoryText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding CacheDirectoryText}" AutomationProperties.Name="缓存目录" MinWidth="120" />
                    <Button x:Name="BrowseCacheButton" Grid.Column="1" Content="选择文件夹…" Command="{Binding BrowseCacheCommand}" Margin="10,0,0,0" />
                  </Grid>
                  <TextBlock Text="最大缓存空间" Style="{StaticResource Caption}" Margin="0,16,0,7" />
                  <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="CacheLimitBox" Width="110" Text="{Binding CacheLimitGiBText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="最大缓存空间 GiB" />
                    <TextBlock Text="GiB" VerticalAlignment="Center" Margin="10,0,18,0" Foreground="{StaticResource Muted}" />
                    <TextBlock Text="{Binding CacheSummary}" VerticalAlignment="Center" Style="{StaticResource Caption}" />
                  </StackPanel>
                  <TextBlock Text="上限是缓存清理目标，并非硬性磁盘配额；正在使用或等待上传的文件可能暂时超出上限。支持两位小数，1 GiB = 1024 MiB。" Style="{StaticResource Caption}" Margin="0,10,0,0" />
                  <TextBlock Text="{Binding CacheValidation}" Visibility="{Binding HasCacheError, Converter={StaticResource VisibleIf}}" Foreground="#C43F45" Margin="0,10,0,0" />
                  <WrapPanel Margin="0,16,0,0">
                    <Button x:Name="ApplyCacheButton" Content="应用缓存设置" Command="{Binding ApplyCacheCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" />
                    <Button x:Name="DefaultCacheButton" Content="恢复默认" Command="{Binding DefaultCacheCommand}" Margin="0,0,10,0" />
                    <Button x:Name="OpenCacheButton" Content="打开缓存目录" Command="{Binding OpenCacheCommand}" Style="{StaticResource TextButton}" />
                  </WrapPanel>
                  <TextBlock Text="{Binding CacheApplyHint}" Style="{StaticResource Caption}" Margin="0,12,0,0" />
                  <TextBlock Text="切换前请保存并关闭正在编辑的云盘文件。旧缓存会保留在原目录，不会自动移动或清理。" Style="{StaticResource Caption}" Margin="0,5,0,0" />
                </StackPanel>
                <Border Style="{StaticResource Rule}" />
                <TextBlock Text="登录数据" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock Text="登录凭证使用 Windows DPAPI 加密，保存在下方目录，不随文件缓存目录切换。" Style="{StaticResource Caption}" />
                <TextBlock Text="{Binding DataPath}" Style="{StaticResource Caption}" FontFamily="Segoe UI" Margin="0,10,0,16" TextTrimming="CharacterEllipsis" ToolTip="{Binding DataPath}" />
                <WrapPanel>
                  <Button Content="打开数据目录" Command="{Binding DataCommand}" />
                  <Button x:Name="LogoutButton" Content="清除登录" Command="{Binding LogoutCommand}" Margin="10,0,0,0" Foreground="#B33C43" />
                </WrapPanel>
                <TextBlock Text="清除登录会先安全断开盘符，再移除本地凭证和应用内浏览器的登录数据。" Style="{StaticResource Caption}" Margin="0,12,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,20,0">
                  <TextBlock Text="{Binding DriverLabel}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding DriverDescription}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                </StackPanel>
                <Button x:Name="InstallButton" Grid.Column="1" Content="安装挂载组件" Command="{Binding InstallCommand}" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <Button x:Name="ExitButton" Content="退出程序" Click="ExitClick" HorizontalAlignment="Left" IsEnabled="{Binding IsIdle}" />
            <TextBlock Text="退出前会等待上传完成。无法确认上传状态时，程序会保留连接。" Style="{StaticResource Caption}" Margin="0,10,0,0" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem x:Name="AboutTab" AutomationProperties.Name="关于交云桥">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource NavIcon}" Text="" />
            <TextBlock Text="关于交云桥" />
          </StackPanel>
        </TabItem.Header>
        <ScrollViewer Style="{StaticResource PageScroll}">
          <StackPanel MaxWidth="900">
            <TextBlock Text="关于交云桥" Style="{StaticResource Title}" />
            <TextBlock Text="连接学校云盘，也连接熟悉的工作方式。" Style="{StaticResource Subtitle}" />
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Image Source="Assets/PanBridge.png" Width="66" Height="66" RenderOptions.BitmapScalingMode="HighQuality" />
                  <StackPanel Margin="18,4,0,0">
                    <TextBlock Text="交云桥 · PanBridge" FontSize="23" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding VersionLabel}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                  </StackPanel>
                </StackPanel>
                <TextBlock Text="上海交通大学 Pan 云盘的第三方 Windows 客户端。通过官方网页登录，在本机将云盘连接为资源管理器盘符。" Foreground="{StaticResource Muted}" LineHeight="24" Margin="0,23,0,0" />
                <Border Style="{StaticResource Rule}" />
                <TextBlock Text="独立开发项目，与上海交通大学及云盘服务提供方无隶属关系。云盘访问权限和登录有效期由学校服务控制。" Style="{StaticResource Caption}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="运行环境与组件" Style="{StaticResource SectionTitle}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="145" />
                    <ColumnDefinition />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock Text="桌面界面" Foreground="{StaticResource Muted}" Margin="0,0,0,16" />
                  <TextBlock Grid.Column="1" Text="WPF · XAML" />
                  <TextBlock Grid.Row="1" Text=".NET 运行时" Foreground="{StaticResource Muted}" Margin="0,0,0,16" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RuntimeLabel}" />
                  <TextBlock Grid.Row="2" Text="WebView2" Foreground="{StaticResource Muted}" Margin="0,0,0,16" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding WebViewLabel}" />
                  <TextBlock Grid.Row="3" Text="WinFsp" Foreground="{StaticResource Muted}" />
                  <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DriverLabel}" />
                </Grid>
                <Border Style="{StaticResource Rule}" />
                <TextBlock Text="TboxWebdav · 云盘协议桥接，使用 GPL-2.0 许可证，修改后的对应源码随运行包提供。" Style="{StaticResource Caption}" />
                <TextBlock Text="rclone · 本地文件挂载，使用 MIT 许可证。" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                <Button Content="第三方组件与许可证" Command="{Binding LicensesCommand}" Style="{StaticResource TextButton}" HorizontalAlignment="Left" Padding="0,10" Margin="0,8,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="18,11" Background="White">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="22" />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Ellipse Width="6" Height="6" VerticalAlignment="Center" HorizontalAlignment="Left">
          <Ellipse.Style>
            <Style TargetType="Ellipse">
              <Setter Property="Fill" Value="#8C9BB1" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                  <Setter Property="Fill" Value="{StaticResource Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                  <Setter Property="Fill" Value="#C43F45" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Ellipse.Style>
        </Ellipse>
        <TextBlock x:Name="StatusMessage" Grid.Column="1" Text="{Binding Message}" FontSize="12" Foreground="{StaticResource Muted}" AutomationProperties.LiveSetting="Polite" />
      </Grid>
    </Border>
    <ProgressBar Grid.Row="1" VerticalAlignment="Top" Height="2" BorderThickness="0" Foreground="{StaticResource Accent}" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource VisibleIf}}" />
  </Grid>
</Window>
