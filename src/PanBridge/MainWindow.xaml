<Window x:Class="PanBridge.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="交云桥 · PanBridge" Icon="Assets/PanBridge.ico" Width="790" Height="590" MinWidth="740" MinHeight="560" WindowStartupLocation="CenterScreen" Background="#F3F6F6" FontFamily="Microsoft YaHei UI" Foreground="{StaticResource Ink}">
  <Grid Margin="36,28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Image x:Name="BrandIcon" Source="Assets/PanBridge.png" Width="60" Height="60" HorizontalAlignment="Left" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
      <StackPanel Grid.Column="1"><TextBlock Text="PANBRIDGE" FontSize="11" FontWeight="SemiBold" Foreground="#70867D"/><TextBlock Text="交云桥，打开即用。" FontSize="28" FontWeight="SemiBold" Margin="0,9,0,0"/><TextBlock Text="自动登录 · 本地挂载 · 按需读取" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,9,0,0"/></StackPanel>
    </Grid>
    <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="26" Margin="0,25,0,22">
      <StackPanel>
        <DockPanel><TextBlock Text="连接状态" FontSize="14" FontWeight="SemiBold"/><Border DockPanel.Dock="Right" HorizontalAlignment="Right" Background="#EAF1EC" CornerRadius="4" Padding="10,4"><TextBlock x:Name="ModeBadge" Text="完整读写" Foreground="#3D725A" FontSize="11"/></Border></DockPanel>
        <TextBlock x:Name="StateText" Text="准备连接" FontSize="23" FontWeight="SemiBold" Margin="0,16,0,0"/>
        <TextBlock x:Name="DetailText" Text="正在检查登录状态…" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" MinHeight="38"/>
        <StackPanel Orientation="Horizontal" Margin="0,17,0,0"><TextBlock Text="盘符" VerticalAlignment="Center" Margin="0,0,12,0"/><ComboBox x:Name="DrivePicker" Width="70" Height="31" FontSize="15"/><ComboBox x:Name="AccessPicker" Width="165" Height="31" Margin="15,0,0,0" SelectionChanged="AccessChanged"><ComboBoxItem Content="只读" Tag="ReadOnly"/><ComboBoxItem Content="读写，禁止删除" Tag="NoDelete"/><ComboBoxItem Content="完整读写，允许删除" Tag="Full"/></ComboBox><CheckBox x:Name="AutoMountCheck" Content="启动后自动挂载" VerticalAlignment="Center" Margin="18,0,0,0" Checked="SettingsChanged" Unchecked="SettingsChanged"/></StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
          <Button x:Name="LoginButton" Content="登录交大云盘" Click="LoginClick"/>
          <Button x:Name="MountButton" Content="连接盘符" Background="#235C48" Foreground="White" Click="MountClick" IsEnabled="False"/>
          <Button x:Name="DisconnectButton" Content="断开" Click="DisconnectClick" IsEnabled="False"/>
          <Button x:Name="OpenButton" Content="打开文件夹" Click="OpenClick" IsEnabled="False" Margin="0"/>
        </StackPanel>
      </StackPanel>
    </Border>
    <DockPanel Grid.Row="2"><StackPanel><TextBlock Text="Cookie 使用 Windows 当前用户加密，保存在此应用的 data 文件夹。" FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock x:Name="DependencyText" Text="正在检查挂载组件…" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="InstallButton" Content="安装挂载组件" Padding="10,7" FontSize="12" Click="InstallClick" Visibility="Collapsed"/><Button x:Name="LogoutButton" Content="清除登录" Padding="10,7" FontSize="12" Click="LogoutClick" Margin="0"/></StackPanel></DockPanel>
  </Grid>
</Window>
