<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PanBridge</AssemblyName>
    <ApplicationIcon>Assets\PanBridge.ico</ApplicationIcon>
    <Product>交云桥（PanBridge）</Product>
    <Description>交大云盘登录与本地磁盘挂载客户端</Description>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Version>0.1.2</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <Resource Include="Assets\PanBridge.ico" />
    <Resource Include="Assets\PanBridge.png" />
  </ItemGroup>
</Project>
